# PEARL environment. Copy to `.env` and fill in what your deployment actually uses.
#
#   cp .env.example .env
#
# Nothing here is read automatically: PEARL does not load `.env` files, because a framework
# that silently picks up ambient configuration makes "why did this run differently" an
# unanswerable question (Article 10). Export these in the shell or service definition that
# starts `pearl-worker` / `pearl-daemon`, and the run record will name the config revision
# they were part of.
#
# Nothing here is required to build or test. Every capability that needs a variable refuses
# *before* doing any work and names the variable it wanted, so an unconfigured machine gets
# a BLOCKED task with an explanation rather than a partial side effect.

# ---------------------------------------------------------------- notifications

# AgentFlow-Notify hub — the only way PEARL reaches the outside world.
# https://github.com/wangsc2024/AgentFlow-Notify
#
# The hub owns the last mile: it fans one notification out to its own claim/ack queue plus
# whatever Discord / LINE / webhook downstreams are bound to the topic. Adding a channel is
# a hub configuration change, not a PEARL change.
AGENTFLOW_NOTIFY_URL=https://your-hub.onrender.com
# The hub's publish token. Required unless the hub runs without auth.
AGENTFLOW_NOTIFY_TOKEN=
# Set to 1 only against a local hub started with NOTIFY_ALLOW_ANON=true.
# AGENTFLOW_NOTIFY_ALLOW_ANON=1
# Default topic when a task does not name one. Hub rule: 1-64 chars of A-Za-z0-9, '-' or '_'.
AGENTFLOW_NOTIFY_TOPIC=PEARL_kiro
# Render's free tier sleeps after ~15 idle minutes and cold-starts in 30-60s, so the first
# publish of the day is slow rather than broken. Raise this before lowering it.
# AGENTFLOW_NOTIFY_TIMEOUT_SECONDS=120

# ------------------------------------------------------------------ agent CLIs

# Subscription-based coding agents. PEARL spawns the CLI; it does not hold these keys itself
# when the CLI manages its own auth. Set the key variable only if your CLI expects it.
# ANTHROPIC_API_KEY=      # runtime: claude_code
# OPENAI_API_KEY=         # runtime: codex (also openai_compatible below)
# CURSOR_API_KEY=         # runtime: cursor

# Where the CLI actually lives, when it is not on PATH under its usual name.
# PEARL_CLAUDE_CMD=claude
# PEARL_CODEX_CMD=codex
# PEARL_CURSOR_CMD=cursor-agent

# ------------------------------------------------------------------- API models

# Each provider is named separately rather than folded into one `openai_compatible` entry,
# so a manifest, a permission rule and a routing decision can all speak about one provider.
# They differ in cost and rate limit, which is exactly what policy cares about.

# Groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_API_BASE=          # override the published endpoint

# Mistral
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest
# MISTRAL_API_BASE=

# NVIDIA
# NVIDIA_API_KEY=
# NVIDIA_MODEL=
# NVIDIA_API_BASE=

# llama.cpp / any local OpenAI-compatible server. No endpoint is published for these, so the
# base URL is mandatory when the runtime is used.
# LLAMA_API_KEY=          # usually unused locally, but sent when set
# LLAMA_MODEL=qwen2.5
# LLAMA_API_BASE=http://localhost:8080/v1

# A generic OpenAI-compatible endpoint. Base URL is mandatory.
# OPENAI_API_BASE=
# OPENAI_MODEL=

# ------------------------------------------------------------------- interpreters

# Which interpreter a mechanical runtime uses. PEARL probes candidates in order and falls
# back to the first, so these are only needed when the probe picks the wrong one — most
# often a Windows machine where `bash.exe` is the WSL launcher and cannot open a Windows
# path, or where `python` is the Microsoft Store stub.
# PEARL_PYTHON=python3
# PEARL_PWSH=pwsh
# PEARL_BASH=C:\Program Files\Git\bin\bash.exe

# --------------------------------------------------------------------- logging

# `json` sends structured logs to stderr. stdout is always reserved for machine-readable
# results (SS 26), so this never changes what a caller parses.
# PEARL_LOG_FORMAT=json
